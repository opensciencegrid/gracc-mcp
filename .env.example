GRACC_BASE_URL=https://gracc.opensciencegrid.org/q
GRACC_DEFAULT_INDEX=gracc.osg.summary
GRACC_ALLOWED_INDICES=gracc.osg.summary
GRACC_MAX_RANGE_DAYS=366
GRACC_MAX_BUCKETS=366
GRACC_MAX_TOP_N=25
GRACC_MAX_SAFE_QUERY_SIZE=25
GRACC_MAX_RESULT_BYTES=262144
GRACC_TIMEOUT_MS=30000
GRACC_RETRY_COUNT=2
GRACC_HTTP_HOST=127.0.0.1
GRACC_HTTP_PORT=3333
GRACC_ENABLE_SAFE_QUERY=true
GRACC_TRUST_PROXY=false
GRACC_RATE_LIMIT_MAX=120
GRACC_RATE_LIMIT_WINDOW_MS=60000
GRACC_MAX_CONCURRENT_UPSTREAM=4
GRACC_MAX_QUEUED_UPSTREAM=32
GRACC_MAX_UPSTREAM_BYTES=1048576
GRACC_CACHE_TTL_SECONDS=300
GRACC_CACHE_MAX_BYTES=33554432
